{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "node16",
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}
